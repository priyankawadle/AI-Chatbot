# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_chatbot
DB_USER=postgres
DB_PASSWORD=postgres

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=supportbot_documents

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_CHAT_MODEL=gpt-4.1-nano
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval
MIN_SCORE_ANSWER=0.35
LOW_CONFIDENCE_SCORE=0.50

# CORS
ALLOWED_ORIGINS=http://127.0.0.1:7860

# JWT
JWT_SECRET=change-this-secret
JWT_ALGO=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
